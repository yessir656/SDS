# ============================================================================
# SDS-CHEM — Environment Configuration
# ============================================================================
# 1. Copy this file to `.env`:   cp .env.example .env
# 2. Fill in real values below.
# 3. Run:  bun run db:push  &&  bun run db:seed  &&  bun run dev
# ============================================================================

# Database — SQLite file path.
# Use a RELATIVE path so it works on any machine. Prisma creates the folder.
DATABASE_URL=file:./db/custom.db

# Admin account — used by `bun run db:seed` to create the first admin user.
# Change these BEFORE deploying to production!
ADMIN_EMAIL=admin@mirdc.dost.gov.ph
ADMIN_PASSWORD=ChangeMeNow!2026

# NextAuth secret — REQUIRED for JWT session signing.
# Generate a strong random secret by running:
#   bun -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# (or:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET=dev-secret-change-me-in-production-7f3a9b2e8c1d4a6f

# Public URL of the app. Use http://localhost:3000 for local dev.
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# AI Provider for SDS Auto-Fill (Admin → Add Chemical → "Auto-fill from PDF")
# ----------------------------------------------------------------------------
# The auto-fill feature uses a vision-language model (VLM) to read an uploaded
# SDS PDF and extract structured fields. Choose ONE provider:
#
#   AI_PROVIDER=zai       (DEFAULT, sandbox-only, FREE)
#     Uses the in-house z-ai-web-dev-sdk. Auto-configured on the Z.ai cloud
#     sandbox via /etc/.z-ai-config — no env vars needed. Does NOT work on a
#     local machine (the internal API endpoint is not publicly reachable).
#
#   AI_PROVIDER=gemini    (RECOMMENDED for local dev, FREE tier)
#     Google Gemini. Free tier: 1,500 req/day on gemini-1.5-flash.
#     Get a key: https://aistudio.google.com/apikey
#     Requires: bun add @google/generative-ai
#     Set: GEMINI_API_KEY (required), GEMINI_MODEL (optional, default gemini-1.5-flash)
#
#   AI_PROVIDER=openai    (paid, ~$0.01 per SDS)
#     OpenAI gpt-4o-mini. Get a key: https://platform.openai.com/api-keys
#     Requires: bun add openai
#     Set: OPENAI_API_KEY (required), OPENAI_MODEL (optional, default gpt-4o-mini)
#
#   AI_PROVIDER=anthropic (paid, ~$0.02 per SDS)
#     Anthropic Claude 3.5 Sonnet. Get a key: https://console.anthropic.com/settings/keys
#     Requires: bun add @anthropic-ai/sdk
#     Set: ANTHROPIC_API_KEY (required), ANTHROPIC_MODEL (optional, default claude-3-5-sonnet-20241022)
#
# To add a new provider: see src/lib/ai-vlm.ts.
# ============================================================================
AI_PROVIDER=zai

# --- Google Gemini ----------------------------------------------------------
# Uncomment + fill if AI_PROVIDER=gemini
# Get a FREE API key at: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day (a lab with 200 SDS PDFs will never exhaust this)
# Default model: gemini-2.0-flash (newer, faster, better vision than 1.5)
# Override with GEMINI_MODEL if you need a different model:
#   gemini-1.5-flash    — older but stable, works with all API keys
#   gemini-2.0-flash    — recommended (default)
#   gemini-2.5-flash    — when available on your account
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI -----------------------------------------------------------------
# Uncomment + fill if AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic --------------------------------------------------------------
# Uncomment + fill if AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
