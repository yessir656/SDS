DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth.js — secret used to sign JWTs (32 random bytes hex).
# Regenerated because the previous .env lost this value.
NEXTAUTH_SECRET=0945cc074f8cd3db54b0e7bdd312125afca1887c2ebd4d6497f2bac060dceac6

# NEXTAUTH_URL is intentionally UNSET. When accessed via the preview URL
# (preview-chat-<id>.space-z.ai) instead of localhost:3000, a hardcoded
# NEXTAUTH_URL=http://localhost:3000 would cause a host mismatch. Instead,
# auth.ts sets trustHost=true so NextAuth auto-detects the host from the
# request headers.

# Admin seed credentials (used only by scripts/seed-db.ts, not at runtime).
ADMIN_EMAIL=admin@mirdc.dost.gov.ph
ADMIN_PASSWORD=ChangeMeNow!2026
