// ============================================================================
// SDS-CHEM — Prisma Schema
// Backend source-of-truth database for chemicals, SDS documents, and admin users.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users (admin accounts only — the public PWA has no user accounts)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("USER") // "SUPER_ADMIN" | "ADMIN" | "USER"
  disabled     Boolean  @default(false)  // super-admin can disable without deleting
  lastLoginAt  DateTime?                  // updated on each successful sign-in
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedSds  SdsDocument[]
  updatedChemicals Chemical[]
  auditLogs    AuditLog[]
}

// ---------------------------------------------------------------------------
// Chemicals — the central catalog entity
// ---------------------------------------------------------------------------

model Chemical {
  id            String   @id
  casNumber     String
  chemicalName  String
  formula       String
  tradeName     String?
  manufacturer  String   @default("")
  supplier      String   @default("")

  signalWord    String   // "danger" | "warning"
  hazardClasses String   // JSON-encoded array of HazardClass
  ghsPictograms String   // JSON-encoded array of GhsPictogram

  storageLocation     String  @default("")
  department          String  @default("")
  safetyInstructions  String  @default("")

  // Regulatory classification tags (DENR-EMB, PDEA, PNP, FDA, ...). JSON-encoded
  // string[] — only populated for chemicals subject to the relevant agency.
  regulatoryTags       String @default("[]")

  version         String  @default("1.0")
  emergencyContact String @default("")
  personalProtectiveEquipment String @default("[]") // JSON array

  firstAidMeasures             String @default("")
  firefightingMeasures         String @default("")
  accidentalReleaseMeasures    String @default("")

  // Server-managed sync / audit fields
  serverVersion Int       @default(1) // incremented on every update (sync key)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // soft-delete (sync propagates deletes)
  updatedById   String?
  updatedBy     User?     @relation(fields: [updatedById], references: [id])

  sdsDocument   SdsDocument?

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([chemicalName])
  @@index([casNumber])
}

// ---------------------------------------------------------------------------
// SDS Documents — one per chemical (1:1)
// ---------------------------------------------------------------------------

model SdsDocument {
  id             String   @id @default(cuid())
  chemicalId     String   @unique
  chemical       Chemical @relation(fields: [chemicalId], references: [id], onDelete: Cascade)

  storageKey     String   // safe generated filename (UUID.pdf) — never user-supplied
  originalFileName String @default("placeholder.pdf")
  fileSize       Int      @default(0)
  mimeType       String   @default("application/pdf")
  contentHash    String   @default("") // sha256 of file content
  status         String   @default("placeholder") // "placeholder" | "available"
  version        Int      @default(1) // incremented on each replace

  uploadedById   String?
  uploader       User?    @relation(fields: [uploadedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit Log — append-only trail of every administrative mutation.
// Super-admins see the full log; regular admins see their own entries.
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // User.id of the actor (null for system actions)
  actorEmail  String?  // Denormalized email so log survives user deletion
  action      String   // e.g. "chemical.create", "sds.replace", "user.disable"
  entityType  String   // "chemical" | "sds" | "user" | "session"
  entityId    String   // id of the affected entity
  summary     String   // Human-readable one-liner
  before      String?  // JSON snapshot of state before (for updates/deletes)
  after       String?  // JSON snapshot of state after (for creates/updates)
  ipAddress   String?  // best-effort client IP
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
}
